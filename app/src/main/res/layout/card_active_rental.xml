<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardActiveRentalContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:visibility="gone"
    app:cardBackgroundColor="#1A1D2C"
    app:cardCornerRadius="18dp"
    app:strokeColor="#D4AF37"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActiveCarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mercedes-AMG GT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveRentalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="ACTIVE TRIP"
                android:textColor="#D4AF37"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real-time Remaining Minutes Display -->
        <TextView
            android:id="@+id/tvTimeRemainingCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⏱️ Time remaining: calculating..."
            android:textColor="#D4AF37"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Penalty Alert Warning (Only appears when late) -->
        <TextView
            android:id="@+id/tvOverdueChargeAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🚨 Overdue: Late penalty KES 50/min is being added."
            android:textColor="#E53935"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCustomerReturnCar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="Return Car (Request Inspection)"
            android:textAllCaps="false"
            android:textColor="#0C0D14"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>